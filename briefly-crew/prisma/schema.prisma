generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Team {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   Member[]
  projects  Project[]
  items     ContentItem[]
  tasks     Task[]
}

model Member {
  id          String   @id @default(cuid())
  teamId      String
  name        String
  role        String
  avatarEmoji String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([teamId])
}

model Project {
  id           String        @id @default(cuid())
  teamId       String
  name         String
  clientName   String?
  description  String?
  color        String?
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]
  tasks        Task[]

  @@index([teamId])
}

model ContentItem {
  id           String    @id @default(cuid())
  teamId       String
  projectId    String
  title        String
  format       String
  publishDate  DateTime?
  topic        String?
  notes        String?
  referenceUrl String?
  status       String    @default("idea")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([teamId])
  @@index([projectId])
}

model Task {
  id            String       @id @default(cuid())
  teamId        String
  projectId     String
  contentItemId String?
  title         String
  description   String?
  assigneeId    String?
  dueDate       DateTime?
  status        String       @default("new")
  priority      String       @default("normal")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  assignee      Member?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
}
